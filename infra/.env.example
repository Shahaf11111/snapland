# Host-side port overrides — change any of these if the default is already
# taken on your machine (e.g. by another project's container, or a tool like
# pgAdmin with a saved connection polling localhost:5432). Only the
# HOST-side port changes; containers keep talking to each other on their
# fixed internal ports regardless of what you set here.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000
FRONTEND_PORT=5173

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Durable area writes and transient previews have separate per-user budgets.
RATE_LIMIT_MAX_PER_MINUTE=50
WS_PREVIEW_MAX_PER_SECOND=20
