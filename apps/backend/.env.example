# Used when running the backend directly (`pnpm dev:backend`) without going
# through `make dev`. If you use `make dev`, these ports/URLs are instead
# injected automatically from infra/.env's POSTGRES_PORT/REDIS_PORT/
# BACKEND_PORT/FRONTEND_PORT, so this file's values don't need to match —
# only edit these if you're running Postgres/Redis yourself, outside Docker.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://snapland:snapland@localhost:5432/snapland
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX_PER_MINUTE=50
# Separate per-user budget for transient drawing previews (REST writes stay at 50/min).
WS_PREVIEW_MAX_PER_SECOND=20
# Per-connection outbound backpressure (bytes of unsent data buffered by `ws`).
# Past SOFT, droppable preview messages are skipped for that client; past HARD,
# the connection is terminated like a failed heartbeat.
WS_BACKPRESSURE_SOFT_BYTES=65536
WS_BACKPRESSURE_HARD_BYTES=1048576
